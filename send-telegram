#!/usr/bin/env python3

import getpass
import json
import os
import stat
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path


MAX_CHUNK_LENGTH = 4000
TOKEN_SERVICE = "codex-power-monitor-telegram-token"
CHAT_SERVICE = "codex-power-monitor-telegram-chat-id"


def usage() -> None:
    print('Usage: send-telegram "message"', file=sys.stderr)
    print("       command | send-telegram", file=sys.stderr)


def read_message() -> str:
    if len(sys.argv) > 1:
        if sys.argv[1] in {"--help", "-h"}:
            usage()
            raise SystemExit(0)
        return " ".join(sys.argv[1:])

    if not sys.stdin.isatty():
        return sys.stdin.read()

    usage()
    raise SystemExit(1)


def read_keychain(service: str) -> str | None:
    if sys.platform != "darwin":
        return None

    result = subprocess.run(
        [
            "/usr/bin/security",
            "find-generic-password",
            "-a",
            getpass.getuser(),
            "-s",
            service,
            "-w",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    return result.stdout.rstrip("\n")


def read_secret_file(name: str) -> str | None:
    config_root = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    path = config_root / "send-telegram" / name
    if not path.exists():
        return None

    mode = stat.S_IMODE(path.stat().st_mode)
    if mode & 0o077:
        raise RuntimeError(f"{path} must not be readable by group or others (run: chmod 600 {path})")

    return path.read_text(encoding="utf-8").strip()


def get_secret(environment_name: str, keychain_service: str, file_name: str) -> str:
    value = os.environ.get(environment_name)
    if value:
        return value

    value = read_keychain(keychain_service)
    if value:
        return value

    value = read_secret_file(file_name)
    if value:
        return value

    raise RuntimeError(
        f"Missing {environment_name}. Set it as an environment variable or store it in "
        f"~/.config/send-telegram/{file_name}."
    )


def send_chunk(token: str, chat_id: str, chunk: str) -> None:
    body = urllib.parse.urlencode({"chat_id": chat_id, "text": chunk}).encode("utf-8")
    request = urllib.request.Request(
        f"https://api.telegram.org/bot{token}/sendMessage",
        data=body,
        method="POST",
    )

    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            payload = json.load(response)
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"Telegram returned HTTP {error.code}: {detail}") from error
    except urllib.error.URLError as error:
        raise RuntimeError(f"Could not reach Telegram: {error.reason}") from error

    if not payload.get("ok"):
        raise RuntimeError(f"Telegram rejected the message: {payload.get('description', 'unknown error')}")


def main() -> int:
    message = read_message()
    if not message.strip():
        print("Message cannot be empty.", file=sys.stderr)
        return 1

    try:
        token = get_secret("TELEGRAM_BOT_TOKEN", TOKEN_SERVICE, "bot-token")
        chat_id = get_secret("TELEGRAM_CHAT_ID", CHAT_SERVICE, "chat-id")

        for start in range(0, len(message), MAX_CHUNK_LENGTH):
            send_chunk(token, chat_id, message[start : start + MAX_CHUNK_LENGTH])
    except RuntimeError as error:
        print(f"send-telegram: {error}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
